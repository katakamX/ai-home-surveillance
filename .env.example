# Copy this file to .env and edit as needed.
# Every value is optional: the defaults below are what the app uses on its own.

# Camera source: a webcam index (0, 1, ...), an RTSP URL, or a video file path.
CAMERA_SOURCE=0

# Detection.
# MODEL_DIR is where weights are kept; MODEL_PATH overrides the full path if set.
# Relative paths are resolved against the project root.
MODEL_DIR=models
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
PERSON_ONLY=true

# Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Where recordings and clips will be written once storage is implemented.
DATA_DIR=data
